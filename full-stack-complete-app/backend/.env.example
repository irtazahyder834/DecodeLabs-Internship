DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=savoria_app
DB_USER=root
DB_PASSWORD=admin123
DB_CHARSET=utf8mb4

JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ISSUER=savoria-api
JWT_EXPIRY_SECONDS=3600

# When true, password-reset responses include the raw reset token/link
# directly in the JSON response instead of emailing it, since this
# project has no email service wired up. Set to false in production
# once real email delivery is added.
APP_DEBUG=true

# Total guests the restaurant can seat per reservation time slot.
# Used to prevent double-booking a time slot beyond capacity.
RESTAURANT_SEATING_CAPACITY=40
